{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inputlab",
  "version": "0.1.5",
  "identifier": "app.inputlab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "inputlab",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#060606"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "native input device tester",
    "longDescription": "detects every connected input device, shows live state, and benchmarks polling rate and dpi from raw input. everything stays local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "en-US" }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
